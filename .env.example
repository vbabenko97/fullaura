# Copy this file to .env, which Git ignores, and fill in only what you need. Never put real
# keys, secrets or invite codes here. backend/app/config.py reads these settings, and
# docs/DEPLOYMENT.md lists the values deployed on Azure.

# development opens the beta to invited sessions; production keeps it closed unless
# FULLAURA_BETA_ENABLED=true.
FULLAURA_ENV=development

# Planning with Muse Spark on Baseten. The hackathon key supports only this model.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Try-ons, the feasibility script and the smoke check call Meta's Muse Image. Use Standard mode
# for personal photos and verify the account's data-use settings.
MODEL_API_KEY=
META_IMAGE_MODEL=muse-image-1.0

# Closed beta. With FULLAURA_ENV=production and FULLAURA_BETA_ENABLED=true the app refuses to
# start unless the session secret, invite digests, a persistent store, the pilot's end and the
# purge time are set.
FULLAURA_BETA_ENABLED=false
# Signs session cookies; production needs 32 or more random characters. Left empty in
# development, each start makes a new secret, so invite links must be opened again.
FULLAURA_SESSION_SECRET=
# Comma-separated SHA-256 digests from data/private/<folder>/invite-hashes.txt, never the codes.
FULLAURA_INVITE_HASHES=
# Where quotas, spending and feedback live: memory:// (gone after a restart),
# file:///absolute/folder, or https://<account>.blob.core.windows.net/<container>, which the
# app reaches with its Azure managed identity.
FULLAURA_STORE_URL=memory://
FULLAURA_PLAN_REQUESTS_PER_INVITE=8
FULLAURA_PREVIEW_REQUESTS_PER_INVITE=12
# US dollars the beta may spend on each kind of model call, less anything spent outside the
# ledger.
FULLAURA_PLANNING_BUDGET_USD=8
FULLAURA_IMAGE_BUDGET_USD=3
# ISO date-times with a time zone, such as 2026-11-06T23:59:00+01:00. Model calls close at the
# pilot's end. At the purge time, which must be later, every pilot record is deleted and the
# beta closes. Leave both empty for local development without an end.
FULLAURA_PILOT_ENDS_AT=
FULLAURA_RECORDS_PURGE_AT=
