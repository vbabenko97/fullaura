# Meta image calls used by feasibility and smoke scripts.
# Use Standard mode for personal photos; verify account data-use settings.
MODEL_API_KEY=
META_IMAGE_MODEL=muse-image-1.0
# Set true only after the formal T-02 evaluation passes. The route remains development-only.
FULLAURA_T02_PREVIEWS_PASSED=false

# Reserved for a future text planner served through Meta.
META_TEXT_MODEL=

# Baseten smoke check. The hackathon key supports only this model.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
