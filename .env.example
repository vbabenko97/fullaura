# Copy to .env for local development. Keep credentials out of Git.
LOOKPILOT_ENV=development
# Optional absolute path to an existing frontend production build.
# LOOKPILOT_WEB_DIST=/absolute/path/to/lookpilot/frontend/dist

# Reserved for the next implementation stage. The scaffold makes no Meta calls.
# Use Standard mode for personal photographs; no *-contributor models.
MODEL_API_KEY=
# Set exact model IDs after checking availability in your Meta account.
META_TEXT_MODEL=
META_IMAGE_MODEL=muse-image-1.0

BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026